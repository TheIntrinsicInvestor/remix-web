# Backend settings. Copy to .remixweb.env (start.bat loads it) or export them yourself.
# Always set REMIX_ACCESS_KEY: without it the backend falls back to a default dev key.
REMIX_ACCESS_KEY=change-me-to-a-long-random-string
REMIX_ALLOWED_ORIGIN=http://localhost:3000
REMIXWEB_PORT=8080
# Where jobs, downloads and outputs are written (default: ~/remixweb-data)
# REMIXWEB_WORK=/path/to/remixweb-data

# Frontend setting. Put this in web/.env.local, not here.
# NEXT_PUBLIC_API_BASE=https://your-backend.example.com
